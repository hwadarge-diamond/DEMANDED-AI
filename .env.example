# ==============================================================================
# EcoPulse: Environment Configuration Template (.env.example)
# In production, these values are loaded via Google Secret Manager.
# Locally, copy this file to .env and supply your credentials.
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Gemini API (Used for Multimodal Ingestion, Agent Reasoning, Function Calling)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro

# Google Cloud Platform & Secret Manager
GCP_PROJECT_ID=ecopulse-dev-9821
GCP_REGION=us-central1
USE_SECRET_MANAGER=false
SECRET_MANAGER_SECRET_ID=ecopulse-secrets

# Firebase Configuration (Authentication, RBAC & Firestore)
FIREBASE_PROJECT_ID=ecopulse-dev-9821
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ecopulse-dev-9821.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_APP_CHECK_ENABLED=true
FIREBASE_APP_CHECK_SECRET=mock-or-real-app-check-token-secret

# Google Maps Platform (Distance Matrix, Geocoding, Directions API)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Security & CORS
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=60
PROMPT_INJECTION_THRESHOLD=0.65
JWT_SECRET=super-secret-jwt-key-for-local-token-verification-change-in-prod

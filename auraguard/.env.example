# AuraGuard Configuration & Multi-Provider AI Credentials
# Note: The application operates with 100% functionality even if all API keys are omitted,
# using the deterministic clinical risk reasoning engine fallback.

# Google Gemini API Key (Optional: for live LLM reasoning)
GEMINI_API_KEY=

# OpenAI API Key (Optional: alternative LLM reasoner)
OPENAI_API_KEY=

# Groq API Key (Optional: fast Llama 3 reasoner)
GROQ_API_KEY=

# Port configuration (default 3000)
PORT=3000
